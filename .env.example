# --------------------------------------------------------------------------
# AlekAgency — environment variables template
#
# Copy this file to .env.local and fill the real values. Never commit .env*.
# In Vercel, set each variable under Settings → Environment Variables.
# --------------------------------------------------------------------------

# Supabase project (SuperCerebro) ------------------------------------------

# Public — read by the browser (login form, etc).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxx"

# Server-only — read only by API routes / Server Components. Keep these
# values in Vercel and never expose them in client code.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...SECRET..."

# Optional — when set, only this email can sign into /admin.
ADMIN_EMAIL="you@example.com"

# Chatbot backend (VPS Hostinger) -----------------------------------------

# Server-only. The chat widget in the browser talks to /api/chat, which
# in turn proxies the user message to this backend. The URL is therefore
# no longer exposed to the browser bundle.
CHATBOT_URL="https://your-vps-host.example.com"
